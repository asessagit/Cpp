{
  "name": "C++ Dev Container",
  "image": "mcr.microsoft.com/devcontainers/cpp:latest",
  "features": {
    "ghcr.io/devcontainers/features/cmake:1": {},
    "ghcr.io/devcontainers/features/gcc:1": {},
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"],
    },
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gdb",
}
